              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3i. GET /users/{userId}/keys (fetch own bundle)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{base_url}}/users/{{user_id}}/keys"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 with at least one device bundle', function () {",
              "  pm.response.to.have.status(200);",
              "  const data = pm.response.json();",
              "  pm.expect(data.devices).to.be.an('array').that.is.not.empty;",
              "  pm.expect(data.devices[0].identity_key.public_key).to.be.a('string').and.not.empty;",
              "});",
              "console.log('user_id is auto-captured by request 3d - just run these in order.');"
            ]
          }
        }
      ]
    },
    {
      "name": "B1. [Account B] Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test User B\",\n  \"phone_number\": \"{{identifier_b}}\",\n  \"password\": \"{{password_b}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
              "console.log('Check the server console for Account B\\'s OTP code (a SECOND, different line from Account A\\'s), then paste it into the otp_code_b collection variable.');"
            ]
          }
        }
      ]
    },
    {
      "name": "B2. [Account B] Verify OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/verify-otp",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{identifier_b}}\",\n  \"code\": \"{{otp_code_b}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 and account is active', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().account_status).to.eql('active');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "B3. [Account B] Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{identifier_b}}\",\n  \"password\": \"{{password_b}}\",\n  \"device_name\": \"Postman B\",\n  \"platform\": \"web\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200, tokens present, user_id_b + other_user_id set', function () {",
              "  pm.response.to.have.status(200);",
              "  const data = pm.response.json();",
              "  pm.expect(data.access_token).to.be.a('string').and.not.empty;",
              "  pm.collectionVariables.set('access_token_b', data.access_token);",
              "  pm.collectionVariables.set('refresh_token_b', data.refresh_token);",
              "  pm.collectionVariables.set('user_id_b', data.user.id);",
              "  // Feeds the EXISTING 3l/3m requests (Account A creating a",
              "  // conversation with 'other_user_id') with Account B's REAL id,",
              "  // instead of needing manual copy-pasting.",
              "  pm.collectionVariables.set('other_user_id', data.user.id);",
              "});",
              "console.log('other_user_id is now Account B\\'s real id. Go back and run 3l/3m now if you have not already, using this real second account.');"
            ]
          }
        }
      ]
    },
