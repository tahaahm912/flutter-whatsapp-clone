              "pm.test('Status is 200 with the remaining older messages, none overlapping page 1', function () {",
              "  pm.response.to.have.status(200);",
              "  const data = pm.response.json();",
              "  pm.expect(data.messages.length).to.be.at.least(1);",
              "  const cursor = pm.collectionVariables.get('pagination_cursor');",
              "  const overlap = data.messages.some(m => m.id === cursor);",
              "  pm.expect(overlap, 'page 2 must not include the cursor message itself').to.be.false;",
              "});"
            ]
          }
        }
