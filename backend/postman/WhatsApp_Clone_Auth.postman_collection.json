    {
      "name": "B7. [Account B] Fetch messages, limit=2 (page 1 - newest)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token_b}}"
          }
        ],
        "url": "{{base_url}}/messages/{{conversation_id}}?limit=2"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 with exactly 2 messages, all delivered', function () {",
              "  pm.response.to.have.status(200);",
              "  const data = pm.response.json();",
              "  pm.expect(data.messages).to.have.lengthOf(2);",
              "  data.messages.forEach(m => pm.expect(m.status).to.eql('delivered'));",
              "  // Response is oldest-first; the FIRST item on this page is the",
              "  // pagination cursor for 'give me messages older than this'.",
              "  pm.collectionVariables.set('pagination_cursor', data.messages[0].id);",
              "});",
              "console.log('This is the real proof of Day 4\\'s delivery-status feature: these were still \\'sent\\' before this exact request.');"
            ]
          }
        }
      ]
    },
