    {
      "name": "3o. POST /messages to a conversation you're not in (expect 403)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{base_url}}/messages",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"conversation_id\": \"00000000-0000-0000-0000-000000000000\",\n  \"client_message_id\": \"{{$guid}}\",\n  \"body\": \"this should be rejected\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 403 with NOT_A_PARTICIPANT', function () {",
              "  pm.response.to.have.status(403);",
              "  pm.expect(pm.response.json().code).to.eql('NOT_A_PARTICIPANT');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3p. POST /messages (send a real message)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{base_url}}/messages",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"conversation_id\": \"{{conversation_id}}\",\n  \"client_message_id\": \"{{last_client_message_id}}\",\n  \"body\": \"Hello from Postman\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Generate the client_message_id ONCE here and store it, so the",
              "// request body and the test script (and 3q afterward) all use the",
              "// exact same value. {{$guid}} evaluates to a NEW random value every",
              "// time it's referenced, so using it directly in the body and then",
              "// trying to read it back in the test script would NOT match.",
              "pm.collectionVariables.set('last_client_message_id', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201 (newly created)', function () {",
              "  pm.response.to.have.status(201);",
              "  const data = pm.response.json();",
              "  pm.expect(data.id).to.be.a('string').and.not.empty;",
              "  pm.expect(data.body).to.eql('Hello from Postman');",
              "  pm.collectionVariables.set('message_id', data.id);",
              "});",
              "console.log('Requires conversation_id to already be set (from 3l/3m) - run those first.');"
            ]
          }
        }
      ]
    },
    {
      "name": "3q. POST /messages again with SAME client_message_id (expect 200, same message id - idempotent retry)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{base_url}}/messages",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"conversation_id\": \"{{conversation_id}}\",\n  \"client_message_id\": \"{{last_client_message_id}}\",\n  \"body\": \"Hello from Postman\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 (retry) with the SAME message id as 3p', function () {",
              "  pm.response.to.have.status(200);",
              "  const data = pm.response.json();",
              "  pm.expect(data.id).to.eql(pm.collectionVariables.get('message_id'));",
              "});",
              "console.log('This proves the retry-safety: same device + same client_message_id must never create a duplicate message.');"
            ]
          }
        }
      ]
    },
    {
      "name": "3r. GET /messages/{conversationId} as sender (expect empty - senders don't receive their own sends)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": "{{base_url}}/messages/{{conversation_id}}"
