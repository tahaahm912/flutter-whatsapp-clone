            "exec": [
              "pm.test('Status is 200 with an empty messages array', function () {",
              "  pm.response.to.have.status(200);",
              "  const data = pm.response.json();",
              "  pm.expect(data.messages).to.be.an('array').that.is.empty;",
              "});",
              "console.log('This is expected, not a bug: the sender never receives their own message via this API (see README/DAY_LOG). To see a DELIVERED message and verify the sent->delivered status transition, log in as the SECOND account (other_user_id) and call this same endpoint with THEIR access_token instead.');"
            ]
          }
        }
      ]
